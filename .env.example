# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
RECEIVING_EMAIL=recipient@example.com

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid
TWILIO_TEMPLATE_SUGERENCIAS_SALUD=HXfbada3ef5842e7ece844063edc6e2c81  # {{1}}=nombre {{2}}=recomendaciones

# PostgreSQL Database
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Application
PORT=5001
LIVEAVATAR_API_KEY=
LIVEAVATAR_OPENAI_SECRET_ID=
# 1 = sandbox (avatar Wayne, ~1 min, gratis). 0 = usa LIVEAVATAR_AVATAR_ID y gasta creditos
LIVEAVATAR_SANDBOX=1
LIVEAVATAR_AVATAR_ID=
ELEVENLABS_API_KEY=
# Voz ElevenLabs importada en LiveAvatar; si esta, la sesion va en modo FULL
LIVEAVATAR_ELEVENLABS_SECRET_ID=
LIVEAVATAR_VOICE_ID=
# Agente de ElevenLabs (scripts/agente-avatar/sync.py). Si esta, tiene prioridad sobre LIVEAVATAR_VOICE_ID
ELEVENLABS_AGENT_ID=
# DigitalOcean Spaces (mismas credenciales que BSL-PLATAFORMA2): audio y fotos de las entrevistas del avatar
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=bsl-fotos
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
